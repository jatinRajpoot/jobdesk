# Set environment variables in your shell or Cloud Run Secret Manager.
# The app does not load this example file automatically.
RIVER_API_KEY=
PARALLEL_API_KEY=
LLM_BASE_URL=https://api.river.ai/v1
LLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
DATABASE_PATH=data/jobdesk.sqlite3
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
